DATA_STORAGE_ROOT_2=/Users/ajay/DATA/CODE/OWL_DATA
DATA_STORAGE_ROOT_3=/Users/ajay/DATA/CODE/OWL_DATA

# Secrets and service credentials. Keep these in local .env only.
POSTGRES_USER=owldrive
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
KEYCLOAK_SEEDED_USERS=testuser,adminuser
KEYCLOAK_SEEDED_PASSWORD=change-me

# OWL-managed signup approvals and legal terms.
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_LEGAL_CURRENT_VERSION=2026-05-26
APP_LEGAL_CONTACT_EMAIL=kumarajax@gmail.com
APP_SIGNUP_APPROVAL_EMAIL_TO=kumarajax@gmail.com
APP_SIGNUP_PASSWORD_ENCRYPTION_KEY=change-this-to-a-long-random-secret
APP_SIGNUP_APPROVAL_TOKEN_DAYS=7

# Gmail SMTP example. Use a Gmail app password, not your account password.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=kumarajax@gmail.com
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# Browser upload chunks stay below Cloudflare's 100 MB request body limit.
NEXT_PUBLIC_UPLOAD_CHUNK_SIZE_BYTES=52428800
